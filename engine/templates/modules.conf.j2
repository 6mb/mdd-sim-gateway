[modules]
autoload = yes

; The upstream IMS Asterisk build contains hundreds of optional modules.  Autoloading the
; unused integrations makes each engine start emit dozens of false ERRORs for configuration
; files MDD intentionally does not ship.  Keep autoload for Asterisk's dependency handling,
; but exclude the integrations and channel drivers outside this product's IMS/SIP/WebRTC
; surface.  The dialplan still uses PJSIP, AMR/Opus, RTP/SRTP, HTTP/WebSocket, AMI and the
; standard dialplan applications/functions.
